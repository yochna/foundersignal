# =============================================================================
# FounderSignal - environment configuration
#
# Copy to .env.local and fill in what you have. EVERY variable is optional:
# the app boots and every page works with an empty file. Each missing key
# downgrades one subsystem to a documented fallback, and /api/health plus the
# in-app status banner tell you exactly which tier is active.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public base URL. Used for absolute links and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Auth (NextAuth)
# -----------------------------------------------------------------------------
# Must match the origin you browse from, or Google OAuth will reject callbacks.
NEXTAUTH_URL=http://localhost:3000

# Signs the session JWT. Generate with: openssl rand -base64 32
# If omitted, a development-only fallback secret is used and a warning is logged.
NEXTAUTH_SECRET=

# Google OAuth 2.0 Web client credentials.
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-app>.vercel.app/api/auth/callback/google
# When BOTH are empty the Google button is hidden and Demo Login is offered
# instead, so you can exercise every signed-in feature before wiring OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Force-enable the Demo Login provider even when Google is configured.
# Never enable this in a real production deployment.
ALLOW_DEMO_LOGIN=

# Comma-separated emails granted the /admin dashboard and ingestion trigger.
# If empty, any signed-in user is treated as admin (demo convenience).
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Database (Supabase)
# -----------------------------------------------------------------------------
# When URL + SERVICE_ROLE_KEY are both present the app uses Postgres.
# Otherwise it falls back to a JSON file store (local) or memory (read-only
# hosts), and the UI shows a "data will not persist" banner.
# Dashboard: Supabase project -> Settings -> API
# The full URL, https://<project-ref>.supabase.co, not the bare project ref.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only used by `npm run db:push` to apply supabase/migrations. Take the session
# pooler string from Supabase -> Connect; the direct db.<ref>.supabase.co host
# is IPv6-only. URL-encode the password (# -> %23, ? -> %3F, @ -> %40).
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# Payments (Razorpay)
# -----------------------------------------------------------------------------
# Dashboard -> Settings -> API Keys. Use the Test Mode keys until you're ready
# to take real payments (toggle Test/Live mode top-right in the dashboard).
# When both are empty, checkout falls back to a labelled demo grant with no
# real charge instead of breaking — same pattern as every AI feature here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional but recommended once live: Dashboard -> Settings -> Webhooks -> Add
# New Webhook, URL https://<your-app>/api/payments/webhook, event
# "payment.captured". Paste the secret shown there. Without it, a payment can
# still be verified via the checkout callback, but there's no backstop if the
# tab closes before that callback runs.
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# AI (Google Gemini)
# -----------------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Without it, all AI features fall back to deterministic heuristic scoring
# and clearly label their output as "Offline heuristic".
GEMINI_API_KEY=
# Google retires dated model ids (gemini-2.0-flash and the 2.5 series are gone
# for new keys) and then returns 404, which looks like an outage. List what your
# key can actually reach with:
#   GET https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
GEMINI_MODEL=gemini-3.5-flash

# Tried in order when the primary 404s (retired) or 503s (high demand, common on
# the newest Flash model on the free tier). Each retry moves down the list.
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-flash-latest

# Thinking tokens count against maxOutputTokens, so structured briefs can be
# truncated by reasoning. 0 disables it, -1 lets the model decide.
GEMINI_THINKING_BUDGET=0

# Override the API endpoint. Only needed for a corporate proxy, or for
# `npm run verify:ai`, which points it at a local stub to test failure handling.
GEMINI_BASE_URL=

# Optional paid fallbacks. Left empty for the free-tier demo.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# -----------------------------------------------------------------------------
# Signal sources (ingestion pipeline)
# -----------------------------------------------------------------------------
# Reddit script app: https://www.reddit.com/prefs/apps
# With credentials the pipeline uses the OAuth API (higher rate limit);
# without them it tries the public JSON endpoint; if that fails the source is
# skipped and reported as degraded.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=FounderSignalBot/1.0 (by /u/your_username)

# GitHub PAT with public_repo scope. Raises the search limit from 10 to 30 rpm.
GITHUB_TOKEN=

# Public RSS/Atom feeds. No credentials required. Override to add more.
RBI_RSS_URL=https://www.rbi.org.in/pressreleases_rss.xml
SEBI_RSS_URL=https://www.sebi.gov.in/sebirss.xml

# -----------------------------------------------------------------------------
# Ingestion scheduling
# -----------------------------------------------------------------------------
# Shared secret for POST /api/admin/ingest and GET /api/cron/ingest.
# Send as: Authorization: Bearer <CRON_SECRET>
# If empty, only a signed-in admin can trigger ingestion.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Quotas and cost ceilings (free-tier protection)
# -----------------------------------------------------------------------------
# Per signed-in user, per UTC day. Anonymous visitors get half of each.
FREE_DAILY_VALIDATIONS=5
FREE_DAILY_RESUME_SCANS=2
FREE_DAILY_CHAT_MESSAGES=20
FREE_DAILY_MATCHES=5
FREE_DAILY_ROADMAPS=5

# Hard stop across all users for one UTC day, in USD of estimated spend.
GLOBAL_DAILY_LLM_BUDGET_USD=0.50

# Hours an identical AI request is served from cache instead of re-billing.
AI_CACHE_TTL_HOURS=24
