# ==============================================================================
# FounderSignal Environment Configuration
# Copy this file to .env.local and fill in your keys
# ==============================================================================

# --- 0. App URL (controls sitemap, OG images, and canonical links) ------------
# In production set this to the Vercel domain (e.g. https://foundersignal-lac.vercel.app).
# Locally it defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 1. AI Engine (Google Gemini) --------------------------------------------
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FALLBACKS=gemini-1.5-flash,gemini-1.5-flash-8b

# --- 2. Online Database & Storage (Supabase) ---------------------------------
# Create a free project at: https://supabase.com/
# Copy from Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- 3. Authentication & Secrets ---------------------------------------------
# Generate a secret via: `openssl rand -base64 32` or any random 32-char string
NEXTAUTH_SECRET=your_random_secret_32_characters_long
NEXTAUTH_URL=http://localhost:3000

# Optional: Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin emails (comma-separated list of emails with admin dashboard access)
ADMIN_EMAILS=your_email@example.com

# --- 4. Signal Ingestion Connectors (Optional) ------------------------------
# GitHub Personal Access Token (for higher rate limits on repo/issue search)
GITHUB_TOKEN=

# Reddit Script App Credentials (from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- 5. Cron / Scheduled Ingestion (Vercel only) -----------------------------
# Shared secret that authorises the Vercel Cron job. Generate a random string
# (e.g. `openssl rand -base64 24`) and set it in both .env.local and Vercel env.
CRON_SECRET=
